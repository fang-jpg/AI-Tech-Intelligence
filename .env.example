# 复制为 .env.txt 或继续使用项目根目录现有的 .env.txt。
# 至少配置一个搜索源。程序按 Tavily -> Exa -> Serper -> Bocha -> Bing -> SerpAPI 的顺序自动选择。
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=
BOCHA_API_KEY=
BING_API_KEY=
SERPAPI_API_KEY=

# OpenAI 兼容的分析模型。也兼容项目现有 GENERAL_AI_REPORT_LLM_* 变量。
GENERAL_AI_REPORT_LLM_API_KEY=
GENERAL_AI_REPORT_LLM_BASE_URL=https://api.openai.com/v1
GENERAL_AI_REPORT_LLM_MODEL=
GENERAL_AI_REPORT_LLM_MODEL_2=
GENERAL_AI_REPORT_LLM_TIMEOUT=90
GENERAL_AI_REPORT_LLM_RETRIES_PER_MODEL=2

# 若要让持久化流水线严格使用 OpenAI GPT-5.6 Sol：
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.6-sol
# GENERAL_AI_REPORT_LLM_BASE_URL=https://api.openai.com/v1
# GENERAL_AI_REPORT_LLM_MODEL=gpt-5.6-sol

# 可选：YouTube Data API v3。仅在 config/sources.yaml 中启用并配置 channel_id 后使用。
YOUTUBE_API_KEY=

# 可选运行参数。
ATI_SEARCH_PROVIDER=auto
ATI_USER_AGENT=AI-Tech-Intelligence/0.1 (+local research; contact=configure-me)
ATI_REQUEST_TIMEOUT=30
ATI_REQUEST_DELAY_SECONDS=0.8
